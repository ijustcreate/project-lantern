{
  "name": "project-lantern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:worker": "wrangler deploy --dry-run --outdir output/worker",
    "preview": "vite preview --host 127.0.0.1",
    "bugs": "node scripts/lantern-bugs.mjs",
    "changelog": "node scripts/lantern-changelog.mjs",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:migrate": "wrangler d1 execute project-lantern-bugs --remote --file worker/schema.sql",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@babylonjs/core": "^8.36.0",
    "@babylonjs/loaders": "^8.56.2",
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tauri-apps/cli": "^2.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.115.0"
  }
}
