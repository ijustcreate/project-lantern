{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Lantern",
  "version": "0.1.0",
  "identifier": "museum.project-lantern",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "Project Lantern Control Center",
        "width": 1440,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
